{
  "name": "bridge-plus-plus",
  "productName": "Bridge++",
  "version": "0.1.18",
  "description": "Windows agent development workspace with independent model sources and native agent runtimes",
  "private": true,
  "type": "module",
  "main": "app/main.mjs",
  "author": "FurutsukiMina-G",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "bridges/qoderbridge",
    "bridges/workbuddy-bridge"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:bridges": "npm test -w qoderbridge && npm test -w workbuddy-bridge",
    "package:win": "npm run build && electron-builder --win dir --publish never",
    "package:installer": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@moonshot-ai/kimi-code": "2.3.1",
    "ajv": "8.20.0",
    "dompurify": "3.4.17",
    "js-yaml": "4.3.2",
    "katex": "0.19.1",
    "marked": "18.1.1",
    "smol-toml": "1.9.1",
    "ws": "8.22.0",
    "yaml": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@qodercn-ai/qodercn-agent-sdk": "1.0.50",
    "@tencent-ai/agent-sdk": "0.3.286",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.furutsukimina.bridgepp",
    "productName": "Bridge++",
    "asar": false,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "assets/runtime",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "assets/**/*",
      "assets/source-locks/**",
      "assets/licenses/KaTeX-fonts-OFL-1.1.txt",
      "!assets/runtime/**/*",
      "!node_modules/@moonshot-ai/kimi-code/native/darwin/prebuilds/**",
      "!node_modules/@moonshot-ai/kimi-code/native/linux/prebuilds/**",
      "!node_modules/@qodercn-ai/**",
      "!node_modules/@tencent-ai/**",
      "package.json",
      "bridges/qoderbridge/dist/src/**/*",
      "bridges/qoderbridge/config/**/*",
      "bridges/qoderbridge/package.json",
      "bridges/workbuddy-bridge/src/**/*",
      "bridges/workbuddy-bridge/scripts/runtime-launcher.mjs",
      "bridges/workbuddy-bridge/scripts/dsh-endpoint.mjs",
      "bridges/workbuddy-bridge/scripts/dsh-owned-listeners.ps1",
      "bridges/workbuddy-bridge/vendor/**/*",
      "bridges/workbuddy-bridge/package.json",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/node-addon-api/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/third_party/**"
    ],
    "asarUnpack": [
      "bridges/workbuddy-bridge/scripts/runtime-launcher.mjs",
      "bridges/workbuddy-bridge/src/contain.mjs"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Bridge++",
      "artifactName": "Bridge++-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FurutsukiMina-G/bridge-plus-plus.git"
  }
}
